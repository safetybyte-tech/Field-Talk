{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs worker/tests/*.test.mjs",
    "test:browser": "playwright test",
    "typecheck": "tsc -b",
    "test:mobile": "playwright test --config=playwright.mobile.config.mjs",
    "test:acceptance": "playwright test --config=playwright.acceptance.config.mjs",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "test:worker-runtime": "node tests/worker-runtime.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.95.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.0.3"
  }
}
